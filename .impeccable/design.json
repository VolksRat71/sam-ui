      "css": ".ds-layer{display:grid;grid-template-columns:220px minmax(80px,1fr);background:var(--panel,#262628);border-bottom:1px solid var(--line,#3a3a3d)}.ds-layer-summary{font-family:Inter,system-ui,sans-serif;font-size:13px;color:var(--text,#f1f1f3);cursor:pointer;display:flex;align-items:center;gap:8px;padding:0 8px;height:28px;font-size:12px;border:0;border-right:1px solid var(--line,#3a3a3d);background:transparent;text-align:left}.ds-swatch{width:8px;height:12px;background:var(--lane-ink,#b8b8c0)}.ds-layer-state{margin-left:auto;padding:1px 8px;border:1px dashed var(--text-muted,#aaaab0);border-radius:2px;font-size:12px;line-height:18px}.ds-layer-summary:focus-visible{outline:2px solid var(--focus,#78b8f5);outline-offset:2px}.ds-layer-summary:focus-visible{outline-offset:-2px}.ds-lane{position:relative}.ds-span{position:absolute;left:12%;right:18%;top:10px;height:8px;border:1px dashed var(--lane-ink,#b8b8c0)}.ds-playhead{position:absolute;left:40%;top:0;bottom:0;width:1px;background:var(--primary,#2d8ceb)}@media(pointer:coarse),(max-width:1023.98px){.ds-layer-summary{height:44px}.ds-span{top:18px}}"
    },
