{
  "name": "sam-ui-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "relay": "npm run merge-schemas && relay-compiler",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "build:pages": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && VITE_API_ENDPOINT=none VITE_BASE=/sam-ui/ VITE_SAMPLES=05_default_juggle.mp4,01_dog.mp4 vite build --outDir dist-pages",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "merge-schemas": "tsx schemas/merge-schemas.ts",
    "smoke": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
    "invariant": "^2.2.4",
    "mediabunny": "^1.60.0",
    "mp4box": "^0.5.2",
    "onnxruntime-web": "^1.30.0",
    "pts": "^0.12.8",
    "react": "^18.3.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-relay": "^16.2.0",
    "react-resizable-panels": "^2.1.9",
    "relay-runtime": "^16.2.0",
    "serialize-error": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.2.4",
    "@types/dom-webcodecs": "^0.1.11",
    "@types/invariant": "^2.2.37",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-relay": "^16.0.6",
    "@types/relay-runtime": "^14.1.24",
    "@vitejs/plugin-react": "^4.7.0",
    "babel-plugin-relay": "^16.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "graphql": "^16.14.2",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "relay-compiler": "^16.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.21",
    "vite-plugin-relay": "^2.1.0",
    "vitest": "^2.1.9"
  }
